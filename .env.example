# BuckTooth environment variables
# Copy to .env and fill in your values.

# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Anthropic API endpoint (e.g. for proxies)
# ANTHROPIC_API_BASE=https://api.anthropic.com

# OpenAI (when agents.llm_provider: openai)
# OPENAI_API_KEY=sk-...

# Brave Search (when tools.websearch.enabled: true)
# BRAVE_SEARCH_API_KEY=

# ── Channels ─────────────────────────────────────────────────────────────────

# Discord
DISCORD_BOT_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=

# Slack (Socket Mode requires both tokens)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Microsoft Teams
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=

# Signal (phone number registered with signal-cli)
# SIGNAL_PHONE_NUMBER=+1234567890

# ── Gateway security (optional) ──────────────────────────────────────────────

# Enables Basic auth on the web dashboard
# DASHBOARD_AUTH_PASSWORD=

# Enables Bearer token auth on all API routes
# BUCKTOOTH_API_TOKEN=

# ── Server ports (optional, defaults shown) ──────────────────────────────────
# LOBSTER_GATEWAY_PORT=8080
# LOBSTER_WEBSOCKET_PORT=18789
# LOBSTER_LOG_LEVEL=info
